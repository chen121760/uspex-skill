# Shell scripts must keep LF: CRLF breaks them on the Linux clusters this skill targets.
*.sh        text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
.gitignore  text eol=lf
LICENSE     text eol=lf

# Keep any future binary asset binary.
*.gz        binary
*.pdf       binary
*.so        binary
